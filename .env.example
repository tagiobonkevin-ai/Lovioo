# Supabase project settings (Dashboard > Project Settings > API). Both values are public and
# browser-safe: row level security protects the data. Never put a service-role/secret key here.
# Leave them unset to run on built-in demo data with browser-only accounts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.example
